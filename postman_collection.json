{
  "info": {
    "name": "Checkmarx Intro Workflow - Validated ZIP + SAST",
    "_postman_id": "5ffb8613-1b14-438e-84ac-25a88eed176e",
    "description": "Validated end-to-end Checkmarx intro workflow.\n\nFlow:\n1. Authentication\n2. Create Project\n3. Create Application\n4. Generate Upload Link\n5. Upload ZIP File\n6. Run Scan\n7. Get Scan Status\n8. Get Scan Results\n\nNotes:\n- This collection is based on the validated working flow from testing.\n- The ZIP upload step uses Authorization header plus binary file upload.\n- After import, set the collection variables before running.\n- For the Upload ZIP request, you may need to re-select the local file in Postman after import.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "region",
      "value": "EU",
      "type": "string"
    },
    {
      "key": "tenant_account_name",
      "value": "ast_integration_tenant_eu",
      "type": "string"
    },
    {
      "key": "iam_base_url",
      "value": "https://eu.iam.checkmarx.net/auth/realms",
      "type": "string"
    },
    {
      "key": "ast_base_url",
      "value": "https://eu.ast.checkmarx.net",
      "type": "string"
    },
    {
      "key": "auth_method",
      "value": "refresh_token",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "client_id",
      "value": "ast-app",
      "type": "string"
    },
    {
      "key": "client_secret",
      "value": "",
      "type": "string"
    },
    {
      "key": "grant_type",
      "value": "refresh_token",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "project_name",
      "value": "Yonah1234",
      "type": "string"
    },
    {
      "key": "project_tags_json",
      "value": "{\"Test123\": \"\"}",
      "type": "string"
    },
    {
      "key": "project_criticality",
      "value": "3",
      "type": "string"
    },
    {
      "key": "project_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "application_name",
      "value": "Yonah 1234",
      "type": "string"
    },
    {
      "key": "application_description",
      "value": "",
      "type": "string"
    },
    {
      "key": "application_criticality",
      "value": "4",
      "type": "string"
    },
    {
      "key": "application_tags_json",
      "value": "{}",
      "type": "string"
    },
    {
      "key": "application_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "upload_url",
      "value": "",
      "type": "string"
    },
    {
      "key": "zip_file_path",
      "value": "C:\\Users\\User\\Downloads\\authentication.zip",
      "type": "string"
    },
    {
      "key": "scan_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "results_limit",
      "value": "10",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication - Refresh Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Auth request succeeded', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "let data = {};",
              "try { data = pm.response.json(); } catch (e) {}",
              "if (data.access_token) pm.collectionVariables.set('access_token', data.access_token);",
              "if (data.refresh_token) pm.collectionVariables.set('refresh_token', data.refresh_token);",
              "if (data.expires_in !== undefined) pm.collectionVariables.set('expires_in', String(data.expires_in));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded",
            "type": "text"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "{{grant_type}}",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "{{client_id}}",
              "type": "text"
            },
            {
              "key": "refresh_token",
              "value": "{{refresh_token}}",
              "type": "text"
            }
          ]
        },
        "url": "{{iam_base_url}}/{{tenant_account_name}}/protocol/openid-connect/token",
        "description": "Run this first. It stores access_token, refresh_token, and expires_in into collection variables."
      },
      "response": []
    },
    {
      "name": "2. Create Project",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create project succeeded', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "let data = {};",
              "try { data = pm.response.json(); } catch (e) {}",
              "if (data.id) pm.collectionVariables.set('project_id', data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json; version=1.0",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{project_name}}\",\n  \"tags\": {{project_tags_json}},\n  \"criticality\": {{project_criticality}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{ast_base_url}}/api/projects",
        "description": "Creates a project and stores id into project_id."
      },
      "response": []
    },
    {
      "name": "3. Create Application",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create application succeeded', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "let data = {};",
              "try { data = pm.response.json(); } catch (e) {}",
              "if (data.id) pm.collectionVariables.set('application_id', data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json; version=1.0",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{application_name}}\",\n  \"description\": \"{{application_description}}\",\n  \"criticality\": {{application_criticality}},\n  \"rules\": [\n    {\n      \"type\": \"project.name.regex\",\n      \"value\": \"^{{project_name}}$\"\n    }\n  ],\n  \"tags\": {{application_tags_json}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{ast_base_url}}/api/applications",
        "description": "Creates an application and stores id into application_id. Uses a validated regex rule to associate the created project."
      },
      "response": []
    },
    {
      "name": "4. Generate Upload Link",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Generate upload link succeeded', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "let data = {};",
              "try { data = pm.response.json(); } catch (e) {}",
              "if (data.url) pm.collectionVariables.set('upload_url', data.url);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json; version=1.0",
            "type": "text"
          }
        ],
        "url": "{{ast_base_url}}/api/uploads",
        "description": "Generates an upload link and stores it into upload_url."
      },
      "response": []
    },
    {
      "name": "5. Upload ZIP File",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/zip",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "file",
          "file": {
            "src": "{{zip_file_path}}"
          }
        },
        "url": "{{upload_url}}",
        "description": "Validated working request shape.\nImportant: after import, Postman may require you to re-select the local file manually under Body > binary/file.\nIf the request errors, verify that upload_url is populated and the file is selected."
      },
      "response": []
    },
    {
      "name": "6. Run Scan (Upload + SAST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Run scan succeeded', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "let data = {};",
              "try { data = pm.response.json(); } catch (e) {}",
              "if (data.id) pm.collectionVariables.set('scan_id', data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json; version=1.0",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"upload\",\n  \"handler\": {\n    \"uploadUrl\": \"{{upload_url}}\"\n  },\n  \"project\": {\n    \"id\": \"{{project_id}}\"\n  },\n  \"config\": [\n    {\n      \"type\": \"sast\",\n      \"value\": {}\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{ast_base_url}}/api/scans",
        "description": "Runs the validated intro scan path and stores id into scan_id."
      },
      "response": []
    },
    {
      "name": "7. Get Scan Status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json; version=1.0",
            "type": "text"
          }
        ],
        "url": "{{ast_base_url}}/api/scans/{{scan_id}}",
        "description": "Checks scan status using scan_id."
      },
      "response": []
    },
    {
      "name": "8. Get Scan Results",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json; version=1.0",
            "type": "text"
          }
        ],
        "url": "{{ast_base_url}}/api/results?scan-id={{scan_id}}&limit={{results_limit}}",
        "description": "Retrieves scan results using scan_id. Default limit is controlled by results_limit."
      },
      "response": []
    }
  ]
}